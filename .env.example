# Copy to .env, replace the placeholders with absolute paths, then: source .env
# This file contains paths only; keep credentials outside the code checkout.
export AIQ_BENCH_ROOT="/absolute/path/to/science-of-ai-prototype/external/ArchitectureIQ"
export AIQ_KB_DATA_ROOT="/absolute/path/to/AIQ_KB_DATA"
# Replace this with an explicitly reviewed release.
export AIQ_KB_POOL="/absolute/path/to/REVIEWED_RELEASE/questions.jsonl"
export AIQ_KB_KEYS="/absolute/path/outside/code/eval_keys.json"

# Select a release only after checking previous exposure and group/seed/variant
# isolation. A different run name or seed does not create a fresh question pool.

# Set these only when the corresponding external artifact is available.
# export AIQ_KB_SEED_KB="${AIQ_KB_DATA_ROOT}/seed_kb.json"
# export AIQ_KB_BLOG_ROOT="/absolute/path/to/blog-checkout"

# export AIQ_KB_WORKDIR="/absolute/path/to/workdir"
