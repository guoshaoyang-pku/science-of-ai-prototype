+# ---------------------------------------------------------------------------
+# Ranking-task rendering. The MCQ task asks for one winning letter; a ranking
+# question asks for the whole order. Only these pieces differ, so the task is a
+# first-class parameter of render_prompt rather than a post-hoc string
+# replacement inside the generator tool.
+# ---------------------------------------------------------------------------
+
+_RANKING_COUNTS = {2: "two", 3: "three", 4: "four", 5: "five", 6: "six", 7: "seven"}
+
+
+def format_ranking_objective(selection_metric: str) -> str:
+    """Closing line of the evaluation section for a ranking question.
+
+    `format_ranking_protocol` names a single winner ("the correct choice has the
+    lowest mean ..."), which is the MCQ task. A ranking question must instead
+    state what the requested order *means*, or the separator convention is unstated.
+    """
+    return (
+        f"- Rank all candidates by their mean {selection_metric} over seeds; "
+        "lower is better, so write the order from lowest to highest."
+    )
+
+
+def format_mcq_answer_section(letters: list[str]) -> str:
+    """The answer section for a pick-one question: a single tagged letter.
+
+    One definition rather than one per caller. `render_prompt` uses it to assemble a
+    fresh prompt; `canonicalize_mcq_prompt` uses it to bring a prompt rendered under
+    an older contract onto the current one, which is what the pool builders and the
+    merge tool need. The earlier form additionally demanded an
+    `<explanation></explanation>` paragraph: nothing scores it (the reward's
+    `AIQ_REQUIRE_EXPLANATION` is off) and it stretched completions toward the token
+    cap, so the contract is a single tag.
+    """
+    if not letters:
+        raise ValueError("letters must be non-empty")
+    joined = ", ".join(letters)
+    return "\n".join(
+        [
+            "## Your answer",
+            f"Choose exactly one of {joined}. End your reply with "
+            "exactly one tagged field, with nothing after it:",
+            "",
+            "<answer>the letter of your chosen option</answer>",
+            "",
+            f"Rules: `<answer>` must contain exactly one letter from "
+            f"{{{joined}}}. The grader reads only the **final** "
+            "`<answer>` tag in your reply.",
+        ]
+    )
+
+
+def format_ranking_answer_section(letters: list[str], *, answer_order: list[str] | None = None) -> str:
+    """The ranking counterpart of the MCQ answer section.
+
+    An example is worth showing -- letters joined by `<` inside one tag is an
+    unusual format -- but any permutation printed here is itself a legal answer,
+    so it is 1-in-n! away from being some question's gold. When the caller knows
+    the gold (`answer_order`) the example is derived from it and asserted to
